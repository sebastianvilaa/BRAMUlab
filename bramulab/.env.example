# BRAMUlab — variables de entorno del frontend/backend mínimo (Bloque 1).
#
# Copiar a .env.development (nunca commitear ese archivo) para desarrollo
# local contra un proyecto Supabase descartable. En Staging/Production estas
# mismas variables se configuran en el panel de Vercel, no en un archivo.
#
# Ver docs/BRAMUlab/Versiones/BRAMUlab_Backend/BRAMUlab_Backend_Informe.md
# para el detalle de cuáles son públicas, cuáles secretas y dónde va cada una.

# Público — nombre del entorno. Uno de: development | staging | production
BRAMU_ENV_NAME=development

# Público — URL del proyecto Supabase de ESTE entorno.
SUPABASE_URL=

# Público (protegida por RLS, no es secreta) — anon key del mismo proyecto.
SUPABASE_ANON_KEY=

# Secreta — SOLO para funciones server-side futuras (Bloque 2+).
# NUNCA se lee desde build-env.mjs ni llega al navegador.
# No la pongas en este archivo salvo que estés fuera del piloto de un
# entorno real; si la necesitás, configurala directo en Vercel como
# "Sensitive"/"Secret" y no la pegues en el chat.
# SUPABASE_SERVICE_ROLE_KEY=
